<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- To know whether the phone is on the workshop Wi-Fi or on mobile data. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Alerts of a machine that stops or waits for the operator. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Required only to hand a verified update APK (downloaded from this project's own GitHub Releases) to Android's system package installer. The app never installs a package silently. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="EH3D Control"
        android:theme="@style/Theme.Eh3d"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true">
        <activity android:name=".Eh3dActivity" android:exported="true" android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Shares an APK held in the app cache with Android's package installer through a temporary content:// URI. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updateprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/update_file_paths" />
        </provider>
    </application>
</manifest>
